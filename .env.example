# Copy to .env and fill in. Never commit .env.

# HTTP server
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# Dispatch target
TARGET_REPO=vandenplas/superset
# Default branch of TARGET_REPO; remediation branches are cut from it.
TARGET_BASE_BRANCH=master
VULNERABILITY_LABEL=vulnerability
# Issues also carrying this label skip the target repo's tests, for a fast demo. Empty disables it.
DEMO_LABEL=demo
GITHUB_PROJECT_URL=https://github.com/users/vandenplas/projects/2
GITHUB_PROJECT_NAME=Superset SVM

# smee.io channel used to deliver GitHub webhooks to a locally running container.
# Only read by the optional "smee" compose profile, not by the dispatcher itself.
SMEE_URL=

# Shared secret configured on the GitHub webhook; deliveries are rejected without it.
GITHUB_WEBHOOK_SECRET=

# Devin service-user API key and organization id (prefix "org-") used to start remediation
# sessions. Without both, the dispatcher runs in dry-run mode.
# PAT that can write the project board: fine-grained with Account permissions -> Projects: Read and
# write, or classic with the `project` scope. Unset means the agent cannot move the issue.
GITHUB_PROJECT_TOKEN=

DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_API_BASE_URL=https://api.devin.ai
DEVIN_REQUEST_TIMEOUT_SECONDS=30

# Optional session tuning.
DEVIN_PLAYBOOK_ID=
DEVIN_MAX_ACU_LIMIT=
# Attribute sessions to a human user (prefix "user-") instead of the service user.
DEVIN_CREATE_AS_USER_ID=

# Set to true to log the remediation prompt instead of starting a Devin session.
DRY_RUN=false
